{
  // Cloudflare Workers configuration for TradeSafe Africa.
  //
  // This file replaces the OpenAI-Sites-specific `.openai/hosting.json`
  // lookup that vite.config.ts previously depended on. It is read directly
  // by `@cloudflare/vite-plugin` (via vinext) for local dev/build, and by
  // `wrangler` / `vinext deploy` for preview and production deploys.
  //
  // REQUIRED before the first real deploy (see docs/DEPLOYMENT.md):
  //   1. `wrangler login` (or set CLOUDFLARE_API_TOKEN in CI)
  //   2. `wrangler d1 create tradesafe-africa-db`      -> paste database_id below
  //   3. `wrangler r2 bucket create tradesafe-africa-documents`
  //   4. Set CLOUDFLARE_ACCOUNT_ID (env var) or add "account_id" here
  //   5. `wrangler secret put SESSION_SECRET` (and any email-provider keys)
  //   6. `npm run db:migrate:remote` to apply drizzle/*.sql to the real D1 DB
  //
  // The placeholder database_id below only works for local Miniflare dev.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradesafe-africa",
  "main": "./worker/index.ts",
  // Pinned to the newest date this repo's pinned wrangler/workerd
  // (package.json: wrangler 4.92.0) actually supports locally. Bump this
  // when you upgrade wrangler — `wrangler dev` refuses to start against a
  // compatibility_date newer than its bundled runtime.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tradesafe-africa-db",
      // Placeholder — replace with the real ID from `wrangler d1 create`.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tradesafe-africa-documents"
    }
  ],

  "observability": {
    "enabled": true
  },

  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tradesafe-africa-db-preview",
          "database_id": "00000000-0000-4000-8000-000000000000",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "tradesafe-africa-documents-preview"
        }
      ]
    }
  }
}
