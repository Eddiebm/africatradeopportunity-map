# Copy this file to .dev.vars (gitignored) for local `vinext dev` / `wrangler dev`.
# In every real environment these are set with `wrangler secret put <NAME>`,
# never committed. See docs/DEPLOYMENT.md.

# HMAC key signing the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-base64-value

# Cloudflare Turnstile secret (server-side). Spin's name is TURNSTILE_SECRET;
# production already has TURNSTILE_SECRET_KEY on the Worker. Either works.
# The public site key is NEXT_PUBLIC_TURNSTILE_SITE_KEY (build-time, not a
# .dev.vars secret). Leave the secret empty locally to fail-open outside
# production — see lib/turnstile.ts.
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=
# Local siteverify hostname allowlist. Production is set in wrangler.jsonc
# vars and must not include localhost.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Priority 10: shared secret the inbound WhatsApp webhook checks against a
# request header before trusting the payload. No real WhatsApp Business
# API provider is connected in this environment — see lib/whatsapp.ts's
# header for the full stopping-condition note. Leave unset locally; the
# webhook still processes requests (documented, not silently faked as
# "verified") but logs plainly that no secret was configured.
WHATSAPP_WEBHOOK_SECRET=

# Production-hardening audit follow-up (Phase 6 — release safety): kill
# switch for real outbound WhatsApp sends, checked in
# lib/whatsapp.ts's getWhatsAppProvider(). No real provider is connected
# yet (only ConsoleWhatsAppProvider exists), so this has no effect today —
# it exists so that whenever a real provider IS wired in, an operator can
# stop real sends immediately (mid-incident, no redeploy) by setting this
# to exactly "false". Leave unset (default: enabled).
WHATSAPP_SENDS_ENABLED=

# Launch-prep (docs/production-readiness.md): Resend API key, checked in
# lib/email.ts's getEmailProvider(). Get a real one at resend.com -> API
# Keys. Leave unset locally: with no key configured, ConsoleEmailProvider
# stays active (the email is logged, not sent) — same honest fallback
# every other provider adapter in this app uses.
RESEND_API_KEY=

# The verified "From" address Resend sends as, e.g.
#   TradeSafe Africa <notifications@tradesafe.africa>
# Leave unset locally/until a domain is verified in the Resend dashboard —
# lib/email.ts falls back to Resend's own sandbox sender
# (onboarding@resend.dev), which can only deliver to the Resend account
# owner's own address, not to arbitrary real users.
EMAIL_FROM=
